# Frontend configuration example.
#
# Copy to `.env` (or `.env.local`) and adjust as needed. Never commit a real
# `.env` file, and never put backend secrets in it: everything prefixed with
# VITE_ is embedded in the browser bundle and is public.

# Base URL the browser uses for backend requests.
#   /api             -> uses the Vite dev/preview proxy (default, local dev)
#   http://host:8000 -> calls that backend directly (must allow CORS)
VITE_API_BASE_URL=/api

# Backend host the Vite dev/preview proxy forwards /api requests to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
