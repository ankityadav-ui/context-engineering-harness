# Context Engineering Harness - environment template
#
# Copy this file to `.env` in the repository root and fill in only the
# services you intend to use. `.env` is gitignored and must never be
# committed. Never put real credentials into this template.
#
# Every value below is a placeholder. Generate your own credentials for
# the services you actually use, and leave the rest empty.

# --- LLM (Ollama only) -------------------------------------------------
# With an Ollama API key set, requests go to Ollama Cloud
# (https://ollama.com). Without a key they go to the local server
# (http://localhost:11434). Set OLLAMA_HOST to force a specific host.
Ollama_API_KEY=
OLLAMA_TEXT_MODEL=gemma4:31b

# Optional override for image requests. Defaults to OLLAMA_TEXT_MODEL,
# so a single-model setup only needs OLLAMA_TEXT_MODEL.
OLLAMA_VISION_MODEL=gemma4:31b

# Optional: force the Ollama host (defaults to cloud when a key is
# set, otherwise the local server).
# OLLAMA_HOST=http://localhost:11434

# Optional: generation timeout in seconds (default 300). The startup
# availability probe always uses a short timeout of its own.
# OLLAMA_TIMEOUT_SECONDS=300

# --- Embeddings --------------------------------------------------------
# Gemini API key used by the embedding service.
GEMINI_API_KEY=

# --- Vector store ------------------------------------------------------
# Pinecone API key used for vector storage and retrieval.
PINECONE_API_KEY=

# Name of the Pinecone index used by this project.
PINECONE_INDEX_NAME=context-engineering-harness

# --- Context engine storage -------------------------------------------
# PostgreSQL connection used by conversations, summaries, and memory.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/context_engine

# --- Knowledge graph ---------------------------------------------------
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- OCR ---------------------------------------------------------------
# Only needed when Tesseract is not installed at its default location.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Logging -----------------------------------------------------------
# Application log level (default INFO).
# CEH_LOG_LEVEL=INFO

# --- Frontend ----------------------------------------------------------
# Streamlit reads this to find the FastAPI backend.
BACKEND_API_URL=http://127.0.0.1:8000
