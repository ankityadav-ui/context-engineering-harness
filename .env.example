# Context Engineering Harness - Ollama-only environment
#
# Copy this file to .env in the repository root and fill in only the
# services you intend to use. .env is gitignored and must never be
# committed.

# --- Ollama (text + vision) -------------------------------------
# Ollama Cloud (https://ollama.com) is used when this key is set;
# otherwise the local server (http://localhost:11434) is used.
# The existing project API key is reused without modification.
Ollama_API_KEY=192c52c654a047f9af40b1b94fd70487.lw-F5viD4y3OnRc-fHWSQvCZ
OLLAMA_TEXT_MODEL=gemma4:31b
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_HOST=

# --- Embeddings (reuse existing Gemini embedding implementation) -
GOOGLE_API_KEY=your_google_api_key_here

# --- Vector store -------------------------------------------------
PINECONE_API_KEY=pcsk_7Nrjy_BXFrQMfmT9X5Q8HxrkNaQBfpmAFQNJirnuyLnGieN8zbRZ3jNyNdWjRtqs3xUca
PINECONE_INDEX_NAME=context-engineering-harness

# --- Context engine storage ----------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/context_engine

# --- Knowledge graph ------------------------------------------------
NEO4J_URI=neo4j+s://562f611b.databases.neo4j.io
NEO4J_USERNAME=562f611b
NEO4J_PASSWORD=x8hjnx1PBx_-y25n3NWW_rQ2aNhb340YwWc-OBv-sB0
NEO4J_DATABASE=562f611b
AURA_INSTANCEID=562f611b
AURA_INSTANCENAME=context_aura

# --- OCR -------------------------------------------------------------
# Only needed when Tesseract is not installed at its default location.
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# --- Frontend -------------------------------------------------------
# Streamlit reads this to find the FastAPI backend.
BACKEND_API_URL=http://127.0.0.1:8000
