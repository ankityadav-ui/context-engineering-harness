# Context Engineering Harness - environment template
#
# Copy this file to .env in the repository root and fill in only the
# services you intend to use. .env is gitignored and must never be
# committed.

# --- Gemini text, streaming, graph extraction, and image Q&A -------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=300

# Gemini retries are bounded. Local fallback is disabled unless explicitly
# selected here; it is used only for ordinary text generation after quota
# exhaustion, never for streaming, images, or knowledge-graph extraction.
# LLM_QUOTA_FALLBACK=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TEXT_MODEL=gemma3:4b

# --- Embeddings (same key, separate fixed model and dimension) -----
# gemini-embedding-001, 1024 dimensions; existing Pinecone index stays compatible.

# --- Vector store -------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=context-engineering-harness

# --- Context engine storage ----------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/context_engine

# --- Knowledge graph ------------------------------------------------
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name

# Recover queued/interrupted document jobs after an API restart.
INGESTION_JOB_RECOVERY_ENABLED=true

# --- OCR -------------------------------------------------------------
# Only needed when Tesseract is not installed at its default location.
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# --- Frontend -------------------------------------------------------
# Streamlit reads this to find the FastAPI backend.
BACKEND_API_URL=http://127.0.0.1:8000
